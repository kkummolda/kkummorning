  "gates": [
    {
      "id": "GATE-01",
      "name": "Z-Index Layer Security Gate",
      "criteria": "#toast-container (z-index 4000) > #global-loading (3000) > .modal-overlay (2500)",
      "status": "PASSED"
    },
    {
      "id": "GATE-02",
      "name": "Duplicate User Fallback Gate",
      "criteria": "signUp() 400/already registered 발생 시 signInWithPassword() 자동 승계",
      "status": "PASSED"
    },
    {
      "id": "GATE-03",
      "name": "UUID Masking Gate",
      "criteria": "isUUID() 정규식 검출 시 raw UUID 표시 금지 및 닉네임/이메일 대체 표시",
      "status": "PASSED"
    }
